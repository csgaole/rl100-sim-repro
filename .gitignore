# --- Training runs (never upload; 282G) ---
runs/

# --- Large binaries ignored by default ---
*.pt
*.pth
*.ckpt
*.h5
*.zarr/
*.zarr

# --- Curated follow-trainable LFS paths (un-ignore) ---
# demos (sku09 H5 episodes + manifests)
!data/
!data/**
!data/demos/
!data/demos/**
# pretrained weights
!models/
!models/pretrained/
!models/pretrained/**
# curated public checkpoints (hardlinks into top-level checkpoints/)
!checkpoints/
!checkpoints/**

# --- Python / caches ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Backups ---
*.bak*
*.bak_*

# --- Analysis artifacts (keep *.py scripts only) ---
analysis/**/videos/
analysis/**/*.mp4
analysis/**/*.npz
analysis/**/*.tgz
analysis/**/*keyframes*.png
analysis/**/out_*.jsonl
analysis/**/pos_*.jsonl
analysis/**/run.log
analysis/**/rescore_results.json
analysis/**/summary.json
analysis/**/bc/
analysis/**/start/
analysis/**/v2/
analysis/**/REPORT.md
